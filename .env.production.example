# Template para o .env REAL do droplet (usado com docker-compose.prod.yml).
# Copie para .env no droplet, preencha com valores reais e NUNCA commite esse
# arquivo. Diferença principal em relação a .env.example (dev local): os hosts
# de Postgres/Redis são os nomes dos serviços do compose, não "localhost".

DATABASE_URL="postgresql://ofertas:TROQUE_ESSA_SENHA@postgres:5432/plataforma_ofertas?schema=public"
POSTGRES_PASSWORD="TROQUE_ESSA_SENHA"

REDIS_URL="redis://redis:6379"

API_PORT=3000
API_HOST=0.0.0.0

# Gere com: openssl rand -hex 32
ADMIN_API_TOKEN="GERE_UM_TOKEN_FORTE_AQUI"
WEBHOOK_HMAC_DEFAULT_TOLERANCE_SECONDS=300

# Dentro da rede do Docker Compose, "api" resolve para o serviço da API.
ADMIN_API_BASE_URL="http://api:3000"

LIMIT_API_BASE_URL=""
LIMIT_API_KEY=""

WHATSAPP_VALIDATION_API_BASE_URL=""
WHATSAPP_VALIDATION_API_KEY=""

# Uma linha por endpoint cadastrado no painel (nome da var = credenciaisRef do endpoint).
# ENDPOINT_C6_API_KEY=""

WORKER1_INTERVAL_MS=5000
WORKER2_INTERVAL_MS=5000
WORKER3_INTERVAL_MS=5000
WORKER4_INTERVAL_MS=5000
WORKER5_INTERVAL_MS=15000
WORKER6_INTERVAL_MS=60000
RECONCILIATION_SLA_MS=600000

SEED_WEBHOOK_SECRET=""

LOG_LEVEL=info
