# Banco de dados
DATABASE_URL="postgresql://ofertas:ofertas@localhost:5432/plataforma_ofertas?schema=public"

# Redis (rate limiting/capacidade dos endpoints — ver packages/queue/src/capacity.ts)
REDIS_URL="redis://localhost:6379"

# API
API_PORT=3000
API_HOST=0.0.0.0

# Segurança
# Token estático do painel administrativo (MVP — ver apps/api/src/admin/auth.ts).
ADMIN_API_TOKEN="troque-por-um-token-forte"
WEBHOOK_HMAC_DEFAULT_TOLERANCE_SECONDS=300

# Painel administrativo (Next.js) — só usados no processo server-side do admin-panel
ADMIN_API_BASE_URL="http://localhost:3000"
# ADMIN_API_TOKEN acima também é lido pelo admin-panel (mesmo valor da API)

# Integrações externas (preencher por ambiente — nunca commitar valores reais)
LIMIT_API_BASE_URL=""
LIMIT_API_KEY=""

# API de Validação de WhatsApp da CorbanTech (ver docs/integrations/APIValidacaoWhatsAppCorbanTech.pdf).
# BASE_URL = raiz do serviço (sem "/api/v1/..."); API_KEY = credencial "cbk_live_...".
WHATSAPP_VALIDATION_API_BASE_URL=""
WHATSAPP_VALIDATION_API_KEY=""

# Token secreto que protege a rota /webhooks/whatsapp-validacao (a CorbanTech não
# assina o callback — a segurança recomendada por eles é embutir esse token na
# própria URL de callback cadastrada no painel deles, ex.:
# https://SEU_DOMINIO/webhooks/whatsapp-validacao?token=<valor abaixo>).
WHATSAPP_WEBHOOK_TOKEN=""

# Credenciais dos endpoints de disparo (ver packages/shared/src/secrets.ts): cada
# Endpoint aponta para uma "credenciais_ref", que é o NOME da env var a ler aqui.
# Exemplo: se um endpoint tem credenciaisRef="ENDPOINT_C6_API_KEY":
# ENDPOINT_C6_API_KEY=""

# Workers — intervalo de polling de cada worker (ms) e SLA de reconciliação
WORKER1_INTERVAL_MS=5000
WORKER2_INTERVAL_MS=5000
WORKER3_INTERVAL_MS=5000
WORKER4_INTERVAL_MS=5000
WORKER5_INTERVAL_MS=15000
WORKER6_INTERVAL_MS=60000
RECONCILIATION_SLA_MS=600000

# Seed (Fase 0/1) — opcional, senão gera um secret aleatório
SEED_WEBHOOK_SECRET=""

# Observabilidade
LOG_LEVEL=info
