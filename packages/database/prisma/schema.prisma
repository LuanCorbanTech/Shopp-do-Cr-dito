// Schema inicial (Fase 0) — modela o diagrama ER da seção 5 do documento de arquitetura.
// Nomenclatura pode evoluir; manter o significado dos campos e os índices.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OfferStatus {
  RECEBIDO
  PROCESSANDO_TELEFONE
  TELEFONE_ATUALIZADO
  VALIDANDO_WHATSAPP
  WHATSAPP_VALIDADO
  AGUARDANDO_ROTEAMENTO
  AGUARDANDO_ENVIO
  EM_PROCESSAMENTO_ENVIO
  ENVIADO
  SEM_WHATSAPP
  SEM_ROTA_CONFIGURADA
  ERRO_TELEFONE
  // CPF que passa na validação de dígito verificador, mas a Lemit não tem
  // nenhum registro pra ele (responde 404) — não é erro transitório, então
  // NÃO entra na fila de retry como ERRO_TELEFONE (tentar de novo nunca vai
  // "achar" o CPF). Fica terminal direto, sem reservar créditos de tentativa
  // à toa.
  CPF_INVALIDO
  ERRO_VALIDACAO_WHATSAPP
  ERRO_ENVIO
  CANCELADO
  EXPIRADO
  // Novo modelo de disparo (substitui o motor de roteamento interno): ao
  // validar o WhatsApp com sucesso, a oferta vai direto pra cá — nenhuma
  // Regra de Roteamento é mais consultada. Um sistema externo (o disparador de
  // WhatsApp) consulta um endpoint próprio (GET /api/v1/leads/aguardando-disparo)
  // pra pegar essas ofertas; ao ser lida por esse endpoint, a oferta passa
  // automaticamente pra DISPARO_CONSULTADO (nunca mais aparece nessa consulta).
  AGUARDANDO_DISPARO
  DISPARO_CONSULTADO
  // Atualizações de status pós-consulta — o próprio sistema de disparo de
  // WhatsApp chama POST /api/v1/leads/status pra informar essas duas
  // mudanças, conforme elas acontecem do lado dele (não são detectadas
  // automaticamente por nós).
  DISPARO_ENVIADO
  DISPARO_RESPONDIDO
}

enum DispatchQueueStatus {
  AGUARDANDO
  RESERVADO
  PROCESSADO
  FALHOU
}

enum DispatchStatus {
  SUCESSO
  FALHA
  RETRYING
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum AuthType {
  NONE
  API_KEY
  BEARER_TOKEN
  BASIC
  HMAC
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// ---------------------------------------------------------------------------
// Origem
// ---------------------------------------------------------------------------

model Webhook {
  id         String   @id @default(uuid())
  identificador String @unique // usado na URL: /webhooks/ofertas/:identificador
  origem     String
  secretHmac String   @map("secret_hmac")
  ativo      Boolean  @default(true)

  // Cada fornecedor de leads pode ter seu próprio jeito de assinar o corpo da
  // requisição — não dá pra assumir que todo mundo usa o mesmo esquema que a gente
  // definiu originalmente (X-Ofertas-Timestamp + X-Ofertas-Signature). Esses três
  // campos deixam isso configurável por parceiro, sem precisar tocar em código pra
  // integrar um fornecedor novo com um esquema já suportado (ver
  // apps/api/src/webhooks/hmac.ts).
  //   "ofertas_v1"          -> esquema original: dois headers (timestamp + signature),
  //                            HMAC-SHA256(secret, "timestamp.corpo"), com janela de
  //                            tolerância contra replay.
  //   "hmac_sha256_simple"  -> um único header, HMAC-SHA256(secret, corpo) em hex, sem
  //                            timestamp/replay (ex.: fornecedor "Odysseia").
  //   "token_simples"       -> sem hash nenhum: o parceiro manda o segredo em texto
  //                            puro direto no header (comparação de igualdade em tempo
  //                            constante). Pra parceiros que não conseguem calcular
  //                            HMAC do lado deles — mais fraco, usar só como último caso.
  esquemaAssinatura String  @default("ofertas_v1") @map("esquema_assinatura")
  headerAssinatura  String  @default("x-ofertas-signature") @map("header_assinatura")
  headerTimestamp   String? @default("x-ofertas-timestamp") @map("header_timestamp")

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  offers Offer[]
  tarefas Tarefa[]

  @@map("webhooks")
}

// ---------------------------------------------------------------------------
// Tarefas agendadas de recebimento (31/08) — liga/desliga o recebimento de
// ofertas de um fornecedor (hoje só Odysseia, desenhado pra caber mais no
// futuro) numa data/horário marcados, até bater uma meta de quantidade.
//
// Fila por fornecedor: se já tem uma tarefa RODANDO pra esse mesmo webhook,
// as outras pendentes esperam a vez (confirmado com o cliente) — nunca duas
// rodando ao mesmo tempo pro mesmo fornecedor. Depois de concluída, o
// recebimento fica desligado até a próxima tarefa da fila ligar de novo
// (também confirmado).
model Tarefa {
  id                String   @id @default(uuid())
  nome              String
  fornecedor        String   // "odysseia" por enquanto — decide qual API de ligar/desligar chamar
  webhookId         String   @map("webhook_id") // qual webhook conta as ofertas recebidas (pode ter mais de um do mesmo fornecedor)
  webhook           Webhook  @relation(fields: [webhookId], references: [id])

  dataHoraExecucao  DateTime @map("data_hora_execucao")
  quantidadeOfertas Int      @map("quantidade_ofertas")

  status            String   @default("PENDENTE") // PENDENTE | RODANDO | CONCLUIDA | ERRO | CANCELADA
  ofertasRecebidas  Int      @default(0) @map("ofertas_recebidas")
  iniciadoEm        DateTime? @map("iniciado_em")
  concluidoEm       DateTime? @map("concluido_em")
  erro              String?

  createdAt         DateTime @default(now()) @map("created_at")

  @@index([webhookId, status], map: "idx_tarefas_webhook_status")
  @@index([status, dataHoraExecucao], map: "idx_tarefas_status_data")
  @@map("tarefas")
}

// ---------------------------------------------------------------------------
// Oferta (entidade central)
// ---------------------------------------------------------------------------

model Offer {
  id               String      @id @default(uuid())
  externalId       String?     @map("external_id")
  idempotencyKey   String      @map("idempotency_key")

  nome             String?
  cpf              String?
  // Extraído de dadosPessoaLemit.data_nascimento (Lemit devolve ISO com timezone,
  // ex.: "1990-02-03T00:00:00-02:00") no momento em que o Worker 1 salva o
  // enriquecimento — promovido pra coluna própria pra dar pra consultar/exportar
  // sem precisar abrir o JSON bruto.
  dataNascimento   DateTime?   @map("data_nascimento")
  // Os campos abaixo (sexo até complemento) são um "retrato" da resposta da
  // Lemit no momento do enriquecimento — pra exibição/registro no painel
  // (pedido explícito: nome, cpf, sexo, nome_mae, data_nascimento, email,
  // telefone, whatsapp, endereço completo). Sempre a entrada de melhor ranking
  // quando o campo original da Lemit é uma lista (emails/celulares/enderecos).
  // Ver extrairInfoPessoaLemit em @plataforma-ofertas/domain. São independentes
  // dos campos que o pipeline usa pra decidir o fluxo (telefoneAtualizado/
  // telefoneValidado/possuiWhatsapp, abaixo).
  sexo             String?
  nomeMae          String?     @map("nome_mae")
  email            String?
  telefoneLemit    String?     @map("telefone_lemit")
  whatsappLemit    Boolean?    @map("whatsapp_lemit")
  endereco         String?
  uf               String?
  cep              String?
  bairro           String?
  cidade           String?
  numero           String?
  logradouro       String?
  complemento      String?
  telefoneOriginal String?     @map("telefone_original")
  telefoneAtualizado String?   @map("telefone_atualizado")
  telefoneValidado String?     @map("telefone_validado")
  // Coluna própria (além do status) pra saber se o número validou WhatsApp —
  // setada junto com telefoneValidado no Worker 2. Existe separado do status
  // pra ficar fácil de filtrar/exportar sem depender de qual dos vários status
  // "de sucesso" a oferta está.
  possuiWhatsapp   Boolean?    @map("possui_whatsapp")

  bancoAutorizado  String?     @map("banco_autorizado")
  produto          String?
  valor            Decimal?    @db.Decimal(14, 2)
  parcelas         Int?

  webhookId        String      @map("webhook_id")
  webhook          Webhook     @relation(fields: [webhookId], references: [id])

  payloadOriginal  Json        @map("payload_original")
  dadosAdicionais  Json?       @map("dados_adicionais")

  // Enriquecimento do lead via Lemit (api.lemit.com.br, consulta por CPF no Worker 1
  // — packages/integrations/limit): o objeto "pessoa" completo devolvido por eles
  // (nome, celulares, e-mails, endereços, score de crédito, vínculos, etc.), salvo
  // direto no registro do lead. A resposta HTTP crua de cada tentativa também é
  // guardada em phone_validations.resposta_limit (auditoria) — este campo aqui é
  // só a cópia "pronta pra uso" mais recente.
  dadosPessoaLemit Json?       @map("dados_pessoa_lemit")

  status           OfferStatus @default(RECEBIDO)

  routingRuleId    String?     @map("routing_rule_id")
  routingRule      RoutingRule? @relation(fields: [routingRuleId], references: [id])

  endpointId       String?     @map("endpoint_id")
  endpoint         Endpoint?   @relation(fields: [endpointId], references: [id])

  campaignId       String?     @map("campaign_id")
  campaign         Campaign?   @relation(fields: [campaignId], references: [id])

  reservedAt       DateTime?   @map("reserved_at")

  // Controle de retry (item 28) — contadores por etapa, já que cada etapa tem sua
  // própria política. proximaTentativaEm é a "não processar antes de" usada pelo
  // Worker 5 para aplicar backoff sem apertar em loop.
  tentativasTelefone Int       @default(0) @map("tentativas_telefone")
  tentativasWhatsapp Int       @default(0) @map("tentativas_whatsapp")
  tentativasEnvio    Int       @default(0) @map("tentativas_envio")
  proximaTentativaEm DateTime? @map("proxima_tentativa_em")

  // API de Validação de WhatsApp da CorbanTech é assíncrona (docs/integrations/
  // APIValidacaoWhatsAppCorbanTech.pdf): guardamos o request_id devolvido por
  // POST /api/v1/whatsapp/check para casar com o resultado, que chega depois por
  // webhook (rota /webhooks/whatsapp-validacao) OU é buscado manualmente pelo
  // Worker 2 se o webhook não chegar em tempo (whatsappCheckIniciadoEm é usado
  // para decidir quando essa consulta manual de fallback é acionada).
  whatsappRequestId       String?   @map("whatsapp_request_id")
  whatsappLoteId          String?   @map("whatsapp_lote_id")
  whatsappCheckIniciadoEm DateTime? @map("whatsapp_check_iniciado_em")

  // Marcadores de PRIMEIRA ocorrência de cada evento pós-disparo (ver POST
  // /api/v1/leads/status) — preenchidos UMA VEZ e NUNCA apagados/sobrescritos
  // depois, mesmo que o status da oferta continue mudando (ex.: de
  // DISPARO_ENVIADO pra DISPARO_RESPONDIDO). Existem à parte do campo
  // "status" (que só guarda o estado ATUAL) justamente pra os contadores
  // "enviados" e "respondidos" do Dashboard serem cumulativos e
  // independentes um do outro — sem isso, contar por "status = X" faz o
  // total de "enviados" cair sempre que uma oferta avança pra "respondido"
  // (só uma pode ser o status atual por vez), o que parecia um "zeramento"
  // pro usuário mesmo sem ser exclusão de dado nenhuma.
  disparoEnviadoEm    DateTime? @map("disparo_enviado_em")
  disparoRespondidoEm DateTime? @map("disparo_respondido_em")

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  processingEvents OfferProcessing[]
  phoneValidations PhoneValidation[]
  dispatchQueueEntries DispatchQueue[]
  dispatches       Dispatch[]
  logs             LogEntry[]
  disparoIndividualTentativas DisparoIndividualTentativa[]

  @@unique([webhookId, idempotencyKey], map: "uq_offer_idempotency")
  @@index([status], map: "idx_offers_status")
  @@index([createdAt], map: "idx_offers_created_at")
  @@index([updatedAt], map: "idx_offers_updated_at")
  @@index([webhookId], map: "idx_offers_webhook_id")
  @@index([endpointId], map: "idx_offers_endpoint_id")
  @@index([routingRuleId], map: "idx_offers_routing_rule_id")
  @@index([cpf], map: "idx_offers_cpf")
  @@index([telefoneValidado], map: "idx_offers_telefone_validado")
  @@index([reservedAt], map: "idx_offers_reserved_at")
  @@index([status, proximaTentativaEm], map: "idx_offers_status_proxima_tentativa")
  @@index([whatsappRequestId], map: "idx_offers_whatsapp_request_id")
  @@index([whatsappLoteId], map: "idx_offers_whatsapp_lote_id")
  @@index([disparoEnviadoEm], map: "idx_offers_disparo_enviado_em")
  @@index([disparoRespondidoEm], map: "idx_offers_disparo_respondido_em")
  @@index([status, whatsappCheckIniciadoEm], map: "idx_offers_status_whatsapp_check_iniciado")
  @@map("offers")
}

// ---------------------------------------------------------------------------
// Histórico de processamento (uma linha por etapa/tentativa)
// ---------------------------------------------------------------------------

model OfferProcessing {
  id              String   @id @default(uuid())
  offerId         String   @map("offer_id")
  offer           Offer    @relation(fields: [offerId], references: [id])

  etapa           String   // ex.: "LIMIT", "WHATSAPP", "ROTEAMENTO", "DISPARO"
  resultado       String   // ex.: "SUCESSO", "FALHA", "IGNORADO"
  request         Json?
  response        Json?
  httpStatus      Int?     @map("http_status")
  tentativa       Int      @default(1)
  tempoExecucaoMs Int?     @map("tempo_execucao_ms")

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([offerId, createdAt], map: "idx_offer_processing_offer_created")
  @@map("offer_processing")
}

// ---------------------------------------------------------------------------
// Validação/atualização de telefone (API Limit)
// ---------------------------------------------------------------------------

model PhoneValidation {
  id                   String   @id @default(uuid())
  offerId              String   @map("offer_id")
  offer                Offer    @relation(fields: [offerId], references: [id])

  limitAtivoNoMomento  Boolean  @map("limit_ativo_no_momento")
  respostaLimit        Json?    @map("resposta_limit")
  possuiWhatsapp       Boolean? @map("possui_whatsapp")

  createdAt            DateTime @default(now()) @map("created_at")

  @@index([offerId], map: "idx_phone_validations_offer_id")
  @@map("phone_validations")
}

// ---------------------------------------------------------------------------
// Roteamento
// ---------------------------------------------------------------------------

model RoutingRule {
  id          String   @id @default(uuid())
  nome        String
  condicoes   Json     // ex.: { "bancoAutorizado": "C6", "webhookId": "..." }
  endpointId  String   @map("endpoint_id")
  endpoint    Endpoint @relation(fields: [endpointId], references: [id])
  prioridade  Int      // menor número = mais específica/precedência maior
  ativo       Boolean  @default(true)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  offers      Offer[]

  @@index([prioridade], map: "idx_routing_rules_prioridade")
  @@index([endpointId], map: "idx_routing_rules_endpoint_id")
  @@map("routing_rules")
}

// ---------------------------------------------------------------------------
// Endpoints de disparo
// ---------------------------------------------------------------------------

model Endpoint {
  id                String     @id @default(uuid())
  nome              String
  url               String
  metodoHttp        HttpMethod @default(POST) @map("metodo_http")
  headers           Json?
  authType          AuthType   @default(NONE) @map("auth_type")
  credenciaisRef    String?    @map("credenciais_ref") // referência ao secret manager, nunca o valor em si

  capacidadeMinuto  Int?       @map("capacidade_minuto")
  capacidadeHora    Int        @map("capacidade_hora")
  capacidadeDia     Int?       @map("capacidade_dia")

  timeoutMs         Int        @default(10000) @map("timeout_ms")
  maxTentativas     Int        @default(5) @map("max_tentativas")
  prioridade        Int        @default(10)
  horarioPermitido  String?    @map("horario_permitido") // ex.: "08:00-20:00"

  ativo             Boolean    @default(true)

  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  routingRules      RoutingRule[]
  offers            Offer[]
  dispatchQueueEntries DispatchQueue[]
  dispatches        Dispatch[]

  @@map("endpoints")
}

// ---------------------------------------------------------------------------
// Fila de disparo (por endpoint)
// ---------------------------------------------------------------------------

model DispatchQueue {
  id          String              @id @default(uuid())
  offerId     String              @map("offer_id")
  offer       Offer               @relation(fields: [offerId], references: [id])
  endpointId  String              @map("endpoint_id")
  endpoint    Endpoint            @relation(fields: [endpointId], references: [id])

  status      DispatchQueueStatus @default(AGUARDANDO)
  scheduledAt DateTime?           @map("scheduled_at")
  reservedAt  DateTime?           @map("reserved_at")

  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([endpointId, status], map: "idx_dispatch_queue_endpoint_status")
  @@map("dispatch_queue")
}

// ---------------------------------------------------------------------------
// Disparos efetivamente executados (Hyperflow)
// ---------------------------------------------------------------------------

model Dispatch {
  id          String         @id @default(uuid())
  offerId     String         @map("offer_id")
  offer       Offer          @relation(fields: [offerId], references: [id])
  endpointId  String         @map("endpoint_id")
  endpoint    Endpoint       @relation(fields: [endpointId], references: [id])

  request     Json?
  response    Json?
  httpStatus  Int?           @map("http_status")
  tentativa   Int            @default(1)
  status      DispatchStatus

  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([endpointId], map: "idx_dispatches_endpoint_id")
  @@index([offerId], map: "idx_dispatches_offer_id")
  @@map("dispatches")
}

// ---------------------------------------------------------------------------
// Tentativas do "Disparo individual" (worker8) — diferente da tabela
// "dispatches" acima, que é ligada à tabela "endpoints" (um mecanismo de
// roteamento mais antigo/separado, com RoutingRule etc.). Os endpoints do
// Disparo individual são configurados como uma lista simples (JSON) no
// painel Integrações, não como linhas na tabela "endpoints" — por isso
// precisa de uma tabela própria, sem FK pra "endpoints".
//
// Guarda toda tentativa (sucesso ou falha) — antes disso só existia como
// log de sistema, sem ficar visível em lugar nenhum da tela pro usuário.
model DisparoIndividualTentativa {
  id          String   @id @default(uuid())
  offerId     String   @map("offer_id")
  offer       Offer    @relation(fields: [offerId], references: [id])

  endpointId  String   @map("endpoint_id") // id do endpoint dentro do JSON de config — não é FK
  endpointUrl String   @map("endpoint_url")
  modelo      String   // "hyperflow" | "ararahq"

  sucesso     Boolean
  httpStatus  Int?     @map("http_status")
  timeout     Boolean  @default(false)
  erro        String?

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([offerId], map: "idx_disparo_individual_tentativas_offer_id")
  @@map("disparo_individual_tentativas")
}

// ---------------------------------------------------------------------------
// Campanhas (base para distribuição percentual futura — item 45)
// ---------------------------------------------------------------------------

model Campaign {
  id                     String   @id @default(uuid())
  nome                   String
  distribuicaoPercentual Json?    @map("distribuicao_percentual") // ex.: { "endpointId1": 40, "endpointId2": 60 }
  ativo                  Boolean  @default(true)

  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  offers                 Offer[]

  @@map("campaigns")
}

// ---------------------------------------------------------------------------
// Configurações dinâmicas (ex.: Consulta Limit ATIVADO/DESATIVADO)
// ---------------------------------------------------------------------------

model IntegrationConfig {
  id        String   @id @default(uuid())
  chave     String   @unique // ex.: "LIMIT_CONSULTA", "WHATSAPP_VALIDACAO"
  valor     Json
  ativo     Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("integration_configs")
}

model SystemSetting {
  id    String @id @default(uuid())
  chave String @unique
  valor Json

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Logs
// ---------------------------------------------------------------------------

model LogEntry {
  id        String   @id @default(uuid())
  offerId   String?  @map("offer_id")
  offer     Offer?   @relation(fields: [offerId], references: [id])

  worker    String?
  nivel     LogLevel @default(INFO)
  mensagem  String
  contexto  Json?    // CPF/telefone devem vir mascarados aqui (ver seção 9 do doc de arquitetura)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([offerId], map: "idx_logs_offer_id")
  @@index([createdAt], map: "idx_logs_created_at")
  @@map("logs")
}

// ---------------------------------------------------------------------------
// Usuários do painel administrativo (login individual + níveis de acesso)
// ---------------------------------------------------------------------------

enum AdminRole {
  ADMINISTRADOR
  OPERADOR
  VISUALIZADOR
}

model AdminUser {
  id           String    @id @default(uuid())
  nome         String
  email        String    @unique
  // Hash + salt gerados com scrypt (módulo nativo "crypto" do Node — sem
  // dependência externa tipo bcrypt). Formato salvo: "salt:hash", ambos em hex.
  senhaHash    String    @map("senha_hash")
  role         AdminRole @default(OPERADOR)
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime? @map("ultimo_acesso")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions     AdminSession[]

  @@map("admin_users")
}

// Sessão simples por token opaque (não JWT) — mais fácil de revogar na hora
// (só apagar a linha), já que é um painel interno de baixo volume.
model AdminSession {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String    @map("user_id")
  user      AdminUser @relation(fields: [userId], references: [id])
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([token], map: "idx_admin_sessions_token")
  @@index([userId], map: "idx_admin_sessions_user_id")
  @@map("admin_sessions")
}
